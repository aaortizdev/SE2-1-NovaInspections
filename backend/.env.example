# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" al repositorio.

# Clave de Google AI Studio (la consigue una sola persona y la comparte por canal privado).
GEMINI_API_KEY=

# Modelo de Gemini. Confirmar el nombre exacto y los límites gratuitos en Google AI Studio.
AI_MODEL=gemini-3.8-flash

# "mock" = respuestas de ejemplo sin llamar a la IA | "real" = llama a Gemini.
AI_MODE=mock

# Solo modo mock: segundos de espera simulada y forzar un error (true/false).
AI_MOCK_DELAY_S=4
AI_MOCK_FAIL=false

# Tiempo máximo (segundos) para una llamada a la IA.
AI_TIMEOUT_S=90

# Máximo de páginas de un PDF que se envían a la IA.
AI_MAX_PAGES=4

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
