# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" al repositorio.

# Clave de Google AI Studio (la consigue una sola persona y la comparte por canal privado).
GEMINI_API_KEY=

# Modelo de Gemini. Confirmar el nombre exacto y los límites gratuitos en Google AI Studio.
AI_MODEL=gemini-3.8-flash

# "mock" = respuestas de ejemplo sin llamar a la IA | "real" = llama a Gemini.
AI_MODE=mock

# Solo modo mock: segundos de espera simulada y forzar un error (true/false).
AI_MOCK_DELAY_S=4
AI_MOCK_FAIL=false

# Opcional: modelos de respaldo (uno o varios separados por coma) si el principal responde 503
# o no contesta a tiempo. Se prueban en orden.
#AI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.6-flash

# Opcional: cuánto "piensa" el modelo antes de responder: minimal | low | medium | high.
# "low" responde bastante más rápido. Vacío = el valor por defecto de Google.
#AI_THINKING=low

# Tiempo máximo (segundos) para una llamada a la IA.
AI_TIMEOUT_S=150

# Máximo de páginas de un PDF que se envían a la IA.
AI_MAX_PAGES=4

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Solo desarrollo: usar también las reglas en estado pendiente_revision (en producción, false).
REGLAS_INCLUIR_PENDIENTES=true
